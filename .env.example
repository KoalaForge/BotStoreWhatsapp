# Bot/Company Name Configuration
# Company name displayed in QRIS templates and user messages (fallback if not configured in database)
BOT_NAME=KOALASTORE.DIGI

# ============================================
# BOT MODE CONFIGURATION
# ============================================
# Available modes: SINGLE, MULTI
# SINGLE - Run one bot from WHATSAPP_PHONE_NUMBER (original behavior)
# MULTI  - Run multiple bots from database (SaaS mode)
BOT_MODE=MULTI

# ============================================
# SINGLE MODE CONFIGURATION (BOT_MODE=SINGLE)
# ============================================
# WhatsApp phone number for SINGLE mode (international format without +)
WHATSAPP_PHONE_NUMBER=6281234567890

# Admin WhatsApp JIDs (comma-separated, format: 628xxx@s.whatsapp.net)
WHITELIST_ID=6281234567890@s.whatsapp.net

# Webhook URL for connection/message notifications (optional, SINGLE mode only)
# In MULTI mode, set webhook_url per bot via API
# WEBHOOK_URL=https://your-backend.com/api/whatsapp/webhook

# ============================================
# MULTI MODE CONFIGURATION (BOT_MODE=MULTI)
# ============================================
# Encryption key for WhatsApp auth sessions (REQUIRED in MULTI mode)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_AUTH_ENCRYPTION_KEY=6c66c5cebcd47133df637d77e5f53cd2680049e7f1379fb8f0af23ad6cbf1ccd

# API Key for bot management endpoints (REQUIRED in MULTI mode)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=50cc4ceb4479042ea349138daab373450feb276db6f6b83032dcb552fe96d048

# API Server Configuration
API_PORT=3000
API_HOST=0.0.0.0

# DATABASE CONFIGURATION
DATABASE_MONGODB_URI=mongodb://127.0.0.1:27017/?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=koalaBOT

# PAYMENT GATEWAY CONFIGURATION
# Available options: 'linkqu', 'tokopay', 'tripay', 'pakasir', 'orderkuota', 'qrispy'
# Default gateway to use for payments (defaults to 'linkqu' if not set)
DEFAULT_PAYMENT_GATEWAY=linkqu

# LINKQU CONFIGURATION
LINKQU_BASE_URL=https://gateway-dev.linkqu.id
LINKQU_CLIENT_ID=testing
LINKQU_CLIENT_SECRET=123
LINKQU_USERNAME=LI307GXIN
LINKQU_PIN=2K2NPCBBNNTovgB
LINKQU_SIGNATURE_KEY=LinkQu@2020
LINKQU_CALLBACK_URL=""
LINKQU_FEE_PERCENTAGE=0.01
LINKQU_METHOD=linkqu-qris

# TOKOPAY CONFIGURATION
TOKOPAY_BASE_URL=https://api.tokopay.id/v1/order
TOKOPAY_MERCHANT_ID=your_merchant_id_here
TOKOPAY_SECRET=your_secret_key_here
TOKOPAY_METHOD=QRISREALTIME
TOKOPAY_FEE_PERCENTAGE=0.017

# TRIPAY CONFIGURATION
TRIPAY_SANDBOX=true
TRIPAY_MERCHANT_CODE=your_merchant_code
TRIPAY_API_KEY=your_api_key_here
TRIPAY_PRIVATE_KEY=your_private_key_here
TRIPAY_CHANNEL=QRIS
TRIPAY_FEE_PERCENTAGE=0.7
TRIPAY_FEE_FIXED=750
TRIPAY_METHOD=tripay-qris

# PAKASIR CONFIGURATION
PAKASIR_PROJECT=your_project_slug
PAKASIR_API_KEY=your_api_key_here
PAKASIR_METHOD=pakasir-qris

# ORDERKUOTA CONFIGURATION
ORDERKUOTA_API_KEY=your_api_key_here
ORDERKUOTA_METHOD=orderkuota-qris

# QRISPY CONFIGURATION
QRISPY_API_KEY=your_api_key_here
QRISPY_METHOD=qrispy-qris

# NOTIFICATION SETTING (comma-separated WhatsApp JIDs)
NOTIFICATION_WHATSAPP_ID=6281234567890@s.whatsapp.net
NOTIFICATION_ACTIVE=true

# TRANSACTION ID PREFIX CONFIGURATION (FALLBACK IF SETTINGS NOT AVAILABLE)
PRODUCT_TRANSACTION_PREFIX=INV
TOPUP_TRANSACTION_PREFIX=TOPUP

# QRIS QR CODE OVERLAY CONFIGURATION
QRIS_OVERLAY_ENABLED=false
QRIS_TEMPLATE_PATH=src/img/qris-template.png

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# Redis password (REQUIRED if running docker/docker-compose.redis.yml)
# Generate with: openssl rand -base64 32
# REDIS_PASSWORD=change-me-strong-secret
#
# Connection URL used by the bot. In docker network use host "redis".
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ============================================
# ENCRYPTION FOR PAYMENT GATEWAY CREDENTIALS
# ============================================
# Required for decrypting payment gateway credentials stored by koalabotbe
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_TOKEN_ENCRYPTION_KEY=your_encryption_key_here

# Encryption key for per-user payment gateway credentials (MULTI mode)
# USER_PG_ENCRYPTION_KEY=your_pg_encryption_key_here

# ============================================
# RESPONSE SPEED / HUMANIZE TUNING
# ============================================
# Bot adds small randomized delays before each reply to mimic human typing,
# plus 1.5-4s gap + 10-30s micro-breaks + 2-5min long-breaks for broadcasts.
# Lower values = faster bot. Set WA_HUMANIZE_DISABLED=true for instant replies
# AND instant broadcasts (anti-ban throttle disabled — accept ban risk on mass sends).
#
WA_HUMANIZE_DISABLED=true    # Skip ALL humanize delays + broadcast throttle (fastest, default false)
# WA_TYPING_MIN_MS=100         # typingDelay floor in ms (default 100)
# WA_TYPING_MAX_MS=600         # typingDelay ceiling in ms (default 600)
# WA_IDLE_MIN_MS=100           # empty-msg delay floor in ms (default 100)
# WA_IDLE_MAX_MS=300           # empty-msg delay ceiling in ms (default 300)
# WA_BACKOFF_MIN_MS=800        # rate-limit backoff floor in ms (default 800)
# WA_BACKOFF_MAX_MS=2000       # rate-limit backoff ceiling in ms (default 2000)

# ============================================
# GROUP PERFORMANCE TUNING
# ============================================
# Comma-separated list of group JIDs the bot should respond in. When set,
# Baileys ignores incoming traffic from groups NOT in the list (via
# shouldIgnoreJid) — drops decryption + handler overhead for large public
# groups where the bot has no business. Leave empty to allow all groups.
# Example: WA_GROUP_ALLOWLIST=120363xxx@g.us,120363yyy@g.us
# WA_GROUP_ALLOWLIST=

# Warn threshold for concurrent in-flight message handlers. Spikes above this
# value log a [WARN] line; sustained high values indicate event-loop
# saturation (which causes WS keepalive misses → code 408 disconnects).
# WA_INFLIGHT_WARN=50

# ============================================
# DEBUG CONFIGURATION
# ============================================
# Set to 'true' to enable verbose Baileys debug logging
BAILEYS_DEBUG=false

# Graceful shutdown timeout (ms)
SHUTDOWN_TIMEOUT_MS=10000

# ============================================
# API DOCUMENTATION
# ============================================
# Password to access /api/docs (disabled if not set)
API_DOCS_PASSWORD=your-secret-docs-password
